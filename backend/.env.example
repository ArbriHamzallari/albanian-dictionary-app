# Database (required). For Supabase, use the pooled connection string with sslmode=require.
DATABASE_URL=postgresql://user:password@localhost:5432/fjalingo

# JWT for auth (required in production). Generate a long random string, e.g. openssl rand -hex 32
JWT_SECRET=your-secret-at-least-32-characters-long

# Google OAuth (optional). The OAuth 2.0 Web client ID from Google Cloud Console.
# Must match VITE_GOOGLE_CLIENT_ID on the frontend. If unset, Google sign-in is
# disabled and the button is hidden.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Optional: admin account used by seed. In production you MUST set these; never commit real values.
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=your-secure-password

PORT=5000
NODE_ENV=development

# Shared secret for the nightly streak/freeze cron (POST /api/cron/daily with the
# x-cron-secret header). Generate a long random string. An external scheduler
# (e.g. cron-job.org, Fly machines, GitHub Actions) sends this header.
CRON_SECRET=your-long-random-cron-secret

# Allowed CORS origins. Comma-separate for multiple (e.g. Vercel + custom domain).
# Development:
FRONTEND_URL=http://localhost:5173
# Production: set to your Vercel site URL — no trailing slash.
# FRONTEND_URL=https://your-app.vercel.app
# Extra origins (comma-separated): custom domain and/or the old host during a cutover.
# FRONTEND_URL_EXTRA=https://fjalingo.com

# Paddle Billing. This is the single source of truth for the checkout environment:
# the frontend reads it from /billing/checkout-config (there is no frontend Paddle env var).
# Sandbox (default): PADDLE_ENVIRONMENT=sandbox with test_ token + sandbox price.
# Production (after Paddle verification): PADDLE_ENVIRONMENT=production with the live_ token
#   and live price ID. Must be exactly "sandbox" or "production" — the frontend fails fast
#   on any other value.
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=test_your_paddle_client_token
# Dual pricing (PRICE-2): one product, two prices. Annual is the hero, monthly the
# anchor. The legacy PADDLE_PREMIUM_PRICE_ID is still read as the annual fallback,
# so an un-renamed prod secret keeps working. Monthly is optional — if unset, the
# pricing page degrades to annual-only.
PADDLE_PRICE_ID_ANNUAL=pri_your_sandbox_premium_yearly_price
PADDLE_PRICE_ID_MONTHLY=pri_your_sandbox_premium_monthly_price
PADDLE_WEBHOOK_SECRET=your_sandbox_webhook_endpoint_secret
# Optional: used by admin metrics revenue estimate (default 25)
# PREMIUM_ANNUAL_PRICE_EUR=25
# Optional: defaults to JWT_SECRET. Set to a long random value before accepting real sandbox testers.
# PADDLE_CHECKOUT_SECRET=your-checkout-signing-secret

# ── Chat safety (INF-3) ──────────────────────────────────────
# Required for encrypted chat at rest (AES-256-GCM). 32 bytes as 64 hex chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MESSAGE_ENC_KEY=your_64_hex_char_message_encryption_key
# Optional: enables the LLM borderline layer of chat moderation (Claude Haiku).
# Absent -> deterministic banlist/PII only. Present but failing -> messages fail closed.
ANTHROPIC_API_KEY=sk-ant-your-key
