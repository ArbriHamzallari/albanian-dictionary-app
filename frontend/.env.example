# Backend API base URL. In production set to your Fly.io API (must end with /api).
# VITE_API_URL=https://fjalingo-api.fly.dev/api
VITE_API_URL=http://localhost:5000/api

# Set to "true" to expose /design gallery in production (admin always has access).
# VITE_SHOW_DESIGN_GALLERY=true

# Google OAuth Web client ID (same value as backend GOOGLE_CLIENT_ID). If unset,
# the "Continue with Google" button is hidden.
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
